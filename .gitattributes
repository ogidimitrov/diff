# Normalise line endings so the repository and every checkout (Windows, Linux,
# macOS) agree on LF.
* text=auto eol=lf

# Keep the distributed archive lean: development-only files are not exported.
/tests             export-ignore
/.github           export-ignore
/.gitattributes    export-ignore
/.gitignore        export-ignore
/phpunit.xml.dist  export-ignore
/phpstan.neon.dist export-ignore
