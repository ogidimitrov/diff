{
    "name": "ogidimitrov/diff",
    "description": "Character-based diff, fuzzy matching and unidiff-style patching for PHP, in the spirit of Google's Diff Match and Patch.",
    "type": "library",
    "keywords": ["diff", "match", "patch", "fuzzy-search", "diff-match-patch", "myers", "bitap"],
    "homepage": "https://github.com/ogidimitrov/diff",
    "license": "MIT",
    "authors": [
        {
            "name": "Ognyan Dimitrov",
            "email": "ognyan.dimitrov@c0nfig.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "OgiDimitrov\\Diff\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OgiDimitrov\\Diff\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    }
}
